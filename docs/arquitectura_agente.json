  "cards": [
    {
      "dot": "cyan",
      "title": "Entrada",
      "items": [
        "Meta firma cada aviso (X-Hub-Signature-256)",
        "Se responde 200 enseguida y el mensaje se atiende una sola vez",
        "Pasado el límite no se llama al modelo"
      ]
    },
    {
      "dot": "emerald",
      "title": "Agente",
      "items": [
        "El modelo elige la herramienta por function calling",
        "Cada herramienta valida sus argumentos con Pydantic",
        "Radicar un reclamo queda pausado hasta que una persona decide"
      ]
    },
    {
      "dot": "rose",
      "title": "Memoria y datos",
      "items": [
        "Una conversación por teléfono (se guarda su hash, no el número)",
        "PostgreSQL guarda la conversación y lo que el cliente cuenta de sí mismo",
        "Qdrant responde las preguntas sobre el sitio de Celsia"
      ]
    },
    {
      "dot": "amber",
      "title": "Segundo cliente (Taller 3)",
      "items": [
        "OpenClaw usa las dos consultas por un servidor MCP de solo lectura",
        "Perfil messaging, sandbox Docker y sin comandos ni archivos",
        "Un chat separado por persona; permisos elevados apagados"
      ]
    },
    {
      "dot": "violet",
      "title": "Panel y respaldo",
      "items": [
        "El panel en vivo (/panel) muestra la herramienta, el tiempo y el costo de cada respuesta",
        "Si una cifra no aparece en lo que devolvieron las herramientas, la respuesta lo avisa",
        "Chat web con QR cuando Meta limita a cinco celulares"
      ]
    }
  ]
