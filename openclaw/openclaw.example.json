{
  "env": {
    "shellEnv": {
      "enabled": true,
      "timeoutMs": 15000
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "commands": {
    "allowFrom": { "*": [] },
    "restart": false
  },
  "models": {
    "providers": {
      "deepseek": {
        "baseUrl": "https://api.deepseek.com",
        "api": "openai-completions",
        "apiKey": { "source": "env", "provider": "default", "id": "DEEPSEEK_API_KEY" },
        "models": [
          { "id": "deepseek-flash", "name": "deepseek-flash" },
          { "id": "deepseek-v4-pro", "name": "deepseek-v4-pro" }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "skills": ["atencion-whatsapp-celsia"],
      "model": {
        "primary": "deepseek/deepseek-flash",
        "fallbacks": ["deepseek/deepseek-v4-pro"]
      },
      "sandbox": {
        "mode": "all",
        "backend": "docker",
        "scope": "agent",
        "workspaceAccess": "none",
        "docker": {
          "image": "openclaw-sandbox:trixie-slim"
        }
      }
    },
    "entries": {
      "main": {
        "workspace": "~/.openclaw/workspace",
        "model": {
          "primary": "deepseek/deepseek-flash",
          "fallbacks": ["deepseek/deepseek-v4-pro"]
        }
      }
    }
  },
  "tools": {
    "toolSearch": false,
    "profile": "messaging",
    "alsoAllow": ["skills_read"],
    "deny": ["group:automation", "group:runtime", "group:fs", "sessions_spawn"],
    "fs": {
      "workspaceOnly": true
    },
    "sessions": {
      "visibility": "self"
    },
    "exec": {
      "mode": "deny"
    },
    "elevated": {
      "enabled": false
    },
    "sandbox": {
      "tools": {
        "alsoAllow": ["celsia__*", "puente__*", "skills_read"]
      }
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": true,
      "dmPolicy": "open",
      "allowFrom": ["*"]
    }
  },
  "mcp": {
    "servers": {
      "celsia": {
        "transport": "stdio",
        "command": "uv",
        "args": ["run", "python", "-m", "taaml.servidor_mcp"],
        "cwd": "${REPO_CELSIA}",
        "toolFilter": {
          "include": [
            "buscar_informacion_celsia",
            "consultar_sedes_celsia",
            "consultar_contactos_celsia",
            "consultar_catalogo_celsia",
            "consultar_canales_de_atencion_celsia",
            "consultar_cobertura_celsia",
            "consultar_tramite_en_linea_celsia",
            "consultar_politica_de_datos_celsia",
            "verificar_canal_oficial_celsia",
            "calcular_factura_estimada_celsia"
          ]
        }
      },
      "puente": {
        "transport": "stdio",
        "command": "uv",
        "args": ["run", "python", "-m", "taaml.puente_mcp"],
        "cwd": "${REPO_CELSIA}",
        "env": {
          "CELSIA_API_URL": "http://127.0.0.1:8000",
          "CHAT_TOKEN": "${CHAT_TOKEN}",
          "WHATSAPP_ALLOWLIST": "${WHATSAPP_ALLOWLIST}"
        },
        "toolFilter": {
          "include": ["atender_cliente_celsia"]
        }
      }
    }
  },
  "plugins": {
    "load": {
      "paths": ["${REPO_CELSIA}/openclaw/plugins/puente-celsia.js"]
    },
    "entries": {
      "whatsapp": {
        "enabled": true
      },
      "puente-celsia": {
        "enabled": true
      }
    }
  }
}
