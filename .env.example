# Copia este archivo a .env y completa solo las keys que vayas a usar.
# NUNCA subas .env a Git.
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
# Memoria en PostgreSQL (opcional): sin esta variable la memoria se guarda en archivos SQLite de data/memoria/.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/taaml   (si no la defines, `make api` levanta un PostgreSQL local y toma la dirección sola; `make api-sqlite` usa archivos SQLite)

# Modelo del agente (opcional): por defecto deepseek-flash. Si falla, se intenta gemini-3.8-flash
# (si hay GOOGLE_API_KEY) y luego el modelo local; para forzar uno, descomenta esta línea.
# TAAML_MODELO_AGENTE=deepseek-flash

# Trazabilidad opcional con LangSmith (smith.langchain.com, cuenta gratuita): sin esta clave no se envía nada.
# Con la clave, la app registra cada pregunta, sus fragmentos, el prompt y la respuesta en el proyecto «taaml-celsia».
LANGSMITH_API_KEY=
# LANGSMITH_TRACING y LANGSMITH_PROJECT no hace falta escribirlos: con la clave puesta, el código los activa (tracing en true, proyecto «taaml-celsia»).
# Para crear datasets y evaluar (scripts/24_evaluar_en_langsmith.py) la clave debe tener permiso de lectura y escritura; una clave de «solo trazas» da 403.

# Clave de quien aprueba lo que el agente deja pendiente (POST /aprobar, encabezado X-Aprobador).
# Sin ella la aprobación queda deshabilitada. Inventa una larga y no la compartas.
# APROBADOR_TOKEN=
# Clave para llamar a POST /chat desde otro servicio (N8N, un script): encabezado X-Api-Key. Sin ella /chat queda abierto (solo lo frena el límite por teléfono).
# El webhook de WhatsApp no la usa: se protege con la firma de Meta. Inventa una larga y no la compartas.
# CHAT_TOKEN=
# RAG_MODO=agente   «agente» (por defecto: el agente decide cuándo buscar) o «cadena» (RAG en cadena: dynamic_prompt con los fragmentos recuperados)
# --- WhatsApp (API Cloud de Meta): sin estas variables el webhook queda deshabilitado ---
# WHATSAPP_VERIFY_TOKEN=       palabra que inventas y escribes también en el panel de Meta al registrar el webhook
# WHATSAPP_APP_SECRET=         secreto de la app de Meta (comprueba la firma de cada aviso)
# WHATSAPP_TOKEN=              token de acceso para enviar mensajes
# WHATSAPP_PHONE_NUMBER_ID=    identificador del número desde el que se responde
# WHATSAPP_ALLOWLIST=          telefonos autorizados, en E.164 y separados por comas (+573001112233,+573104445566),
#                              o «*» para dejarlo abierto al auditorio (el limite por telefono sigue protegiendo la cuota).
#                              Se ve en /api/salud como allowlist_whatsapp.
#                              Nota: restringe tanto el webhook propio de Meta como el puente del canal de OpenClaw.
# --- Demostración (opcionales) ---
# APROBADOR_WHATSAPP=   teléfono de quien aprueba reclamos con botones por WhatsApp (con indicativo, solo dígitos); debe ser destinatario de prueba de Meta
# VOZ_ACTIVA=1          TENTATIVO: atiende notas de voz (necesita instalar faster-whisper a mano; ver src/taaml/voz.py)
# VOZ_MODELO=base       tamaño del modelo de voz
# --- Límite de mensajes por teléfono (POST /chat y WhatsApp): protege la cuota del modelo ---
# LIMITE_MENSAJES=8      mensajes permitidos por teléfono en cada ventana (0 lo apaga)
# LIMITE_VENTANA_S=60    duración de la ventana, en segundos
# WHATSAPP_API_VERSION=        opcional; por defecto v23.0

# --- OpenClaw (gateway y canal de WhatsApp de la sustentación final) ---
# La configuracion versionada esta en openclaw/openclaw.example.json; estas variables la completan al instalar
# con `make openclaw-instalar`. No las subas con valores reales.
# OPENCLAW_GATEWAY_TOKEN=   token del gateway (largo y aleatorio); `openclaw` lo pide al conectar clientes
# WHATSAPP_ALLOWLIST=       telefonos autorizados a hablar con el bot, en E.164 separados por comas (+573001112233,+573104445566)
#                           o «*» para el auditorio (canal abierto); ver D54 y `make qr-whatsapp ... --app`
# REPO_CELSIA=              ruta absoluta de este repositorio en el equipo donde corre OpenClaw (para lanzar el MCP por stdio)
