{
  "$comentario": "Plantilla saneada de la configuración endurecida de OpenClaw (decisión D35). Las claves ${...} se resuelven con las variables de entorno al instalar: scripts/47_openclaw_instalar.py. No pongas claves reales aquí.",
  "gateway": {
    "bind": "loopback",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/openclaw-workspace",
      "model": {
        "primary": "deepseek/deepseek-flash",
        "fallbacks": ["google/gemini-3.8-flash"]
      },
      "sandbox": {
        "mode": "docker",
        "scope": "all",
        "workspaceAccess": "none",
        "image": "openclaw-sandbox:trixie-slim"
      }
    }
  },
  "tools": {
    "profile": "messaging",
    "deny": ["group:automation", "group:runtime", "group:fs", "sessions_spawn"],
    "fs": {
      "workspaceOnly": true
    },
    "exec": {
      "mode": "deny",
      "requireApproval": true
    },
    "elevated": {
      "enabled": false
    },
    "browser": {
      "enabled": false
    },
    "sandbox": {
      "tools": {
        "alsoAllow": ["celsia__*"]
      }
    }
  },
  "channels": {
    "whatsapp": {
      "enabled": true,
      "dmScope": "per-channel-peer",
      "allowlist": ["${WHATSAPP_ALLOWLIST}"]
    }
  },
  "mcp": {
    "servers": {
      "celsia": {
        "transport": "stdio",
        "command": "uv",
        "args": ["run", "python", "-m", "taaml.servidor_mcp"],
        "cwd": "${REPO_CELSIA}",
        "tools": {
          "allow": [
            "buscar_informacion_celsia",
            "consultar_sedes_celsia",
            "consultar_contactos_celsia",
            "consultar_catalogo_celsia",
            "consultar_puntos_de_pago_celsia",
            "consultar_tiendas_celsia",
            "consultar_canales_de_atencion_celsia",
            "consultar_cobertura_celsia",
            "consultar_tramite_en_linea_celsia",
            "consultar_politica_de_datos_celsia"
          ]
        }
      }
    }
  }
}
