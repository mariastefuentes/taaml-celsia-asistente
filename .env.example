# Copia este archivo a .env y completa solo las keys que vayas a usar.
# NUNCA subas .env a Git.
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
# Memoria en PostgreSQL (opcional): sin esta variable la memoria se guarda en archivos SQLite de data/memoria/.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/taaml

# Modelo del agente (opcional): por defecto gemini-3.8-flash. Si el proveedor lo satura (503), se intenta
# gemini-3.5-flash y luego el modelo local; para forzar uno, descomenta esta línea.
# TAAML_MODELO_AGENTE=gemini-3.5-flash

# Trazabilidad opcional con LangSmith (smith.langchain.com, cuenta gratuita): sin esta clave no se envía nada.
# Con la clave, la app registra cada pregunta, sus fragmentos, el prompt y la respuesta en el proyecto «taaml-celsia».
LANGSMITH_API_KEY=
# LANGSMITH_TRACING y LANGSMITH_PROJECT no hace falta escribirlos: con la clave puesta, el código los activa (tracing en true, proyecto «taaml-celsia»).
# Para crear datasets y evaluar (scripts/24_evaluar_en_langsmith.py) la clave debe tener permiso de lectura y escritura; una clave de «solo trazas» da 403.
