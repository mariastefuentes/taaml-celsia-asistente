  "cards": [
    {
      "dot": "cyan",
      "title": "Antes del agente",
      "items": [
        "El plugin fija el teléfono con el remitente verificado: el modelo de OpenClaw no puede cambiarlo",
        "La API pide su clave y limita a 8 mensajes por minuto por teléfono"
      ]
    },
    {
      "dot": "emerald",
      "title": "Dentro del agente",
      "items": [
        "El modelo pide una herramienta por function calling; Pydantic valida los argumentos",
